NODE_ENV=development
PORT=4000
MONGODB_URI=<FILL_ME>
CORS_ORIGINS=http://localhost:3000
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<GENERATE_SECURE_SECRET>
# Seconds
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# Defaults to strict (first-party; the API serves the web client)
REFRESH_COOKIE_SAMESITE=
STUDENT_ID_REGEX=^\d{8}$
STAFF_ID_REGEX=^STF-\d{4,6}$
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Directory of the built web client (frontend `npm run build` output) to serve from this origin
STATIC_DIR=../frontend/out
# Proxies in front of the app (Render: 1). Used to find the client IP for rate limiting.
TRUST_PROXY_HOPS=0
# Optional: creates the first admin on an empty database; password change is forced at first sign-in
SEED_ADMIN_STAFF_ID=
SEED_ADMIN_PASSWORD=

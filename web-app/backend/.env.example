NODE_ENV=development
PORT=4000
MONGODB_URI=<FILL_ME>
CORS_ORIGINS=http://localhost:3000
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<GENERATE_SECURE_SECRET>
# Seconds
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# Defaults to lax in development and none (with Secure) in production
REFRESH_COOKIE_SAMESITE=
STUDENT_ID_REGEX=^\d{8}$
STAFF_ID_REGEX=^STF-\d{4,6}$
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
